# ============================================================
# LockDoc Authentication Server - Environment Configuration
# ============================================================
#
# Real emails are sent through the EmailJS HTTP API
# (backend/services/emailService.js). Fill in the three
# EMAILJS_* values below to enable real sending.
#
# HOW TO GET THESE VALUES:
# 1. Sign up (free) at https://www.emailjs.com
# 2. Email Services -> Add New Service -> connect Gmail/Outlook
#    -> copy the "Service ID"                  -> EMAILJS_SERVICE_ID
# 3. Email Templates -> Create New Template. The template body
#    MUST use these exact variable names:
#      {{to_name}} {{to_email}} {{otp_code}} {{app_name}} {{expiry_minutes}}
#    -> copy the "Template ID"                 -> EMAILJS_TEMPLATE_ID
# 4. Account -> General -> copy the "Public Key" -> EMAILJS_PUBLIC_KEY
#    (optionally also copy "Private Key"          -> EMAILJS_PRIVATE_KEY)
#
# CRITICAL — enable non-browser API access:
#    EmailJS blocks server-side calls by default. Go to
#    Account -> Security -> turn ON "Allow EmailJS API for
#    non-browser applications". Without this every send fails
#    with a 403 error even if all IDs above are correct.
#
# AFTER FILLING THIS IN:
#   1. Rename this file to .env (or edit backend/.env directly)
#   2. Run:  node test-email.js you@example.com
#      This confirms the credentials work before you rely on
#      the full registration/login flow.
#   3. Start the server:  node server.js
#      Watch the startup log for "✅ EmailJS configured".
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (REQUIRED — server refuses to start without it)
# Get it from Atlas -> Database -> Connect -> Drivers, then replace <password>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lockdoc?retryWrites=true&w=majority

# JWT signing secret (REQUIRED for login sessions)
JWT_SECRET=change_this_to_a_long_random_string

# QR encryption secret (REQUIRED — without this, vault/folder QR codes
# cannot be generated and vault creation will fail).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=replace_with_a_generated_64_char_hex_string

# EmailJS credentials (REQUIRED for real emails)
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
# Optional — Account -> General -> Private Key (recommended for server calls)
EMAILJS_PRIVATE_KEY=

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# After setting up, rename this file to .env
# Then run: node server.js
